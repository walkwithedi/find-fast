{
  "name": "find-fast-design-tokens",
  "version": "1.0",
  "note": "与 design/tokens.css 一一对应；颜色键名去掉前缀 --，按 light/dark 两套。GTK 侧见 design/gtk.css。",
  "color": {
    "light": {
      "bg": "#e9edf1",
      "surface": "#ffffff",
      "surface-2": "#f7f9fa",
      "surface-3": "#eef1f4",
      "hover": "#f4f7fa",
      "sel": "#eff4ff",
      "sel-line": "#2f55d4",
      "ink": "#14181d",
      "ink-2": "#4b5563",
      "ink-3": "#66717e",
      "line": "#e5e9ed",
      "line-2": "#d3dae1",
      "accent": "#2f55d4",
      "accent-solid": "#2f55d4",
      "on-accent": "#ffffff",
      "accent-ink": "#22409e",
      "accent-soft": "#ecf0fc",
      "ok": "#0b6b4f",
      "ok-soft": "#e7f4ee",
      "warn": "#8a5a00",
      "bad": "#b3261e",
      "mark-bg": "#ffe9a8",
      "mark-fg": "inherit",
      "ico-folder": "#9a6f16"
    },
    "dark": {
      "bg": "#0a0c0f",
      "surface": "#14181d",
      "surface-2": "#191e24",
      "surface-3": "#1f252c",
      "hover": "#1d232a",
      "sel": "#1b2436",
      "sel-line": "#8aa2ff",
      "ink": "#e8edf2",
      "ink-2": "#9aa6b3",
      "ink-3": "#7f8a97",
      "line": "#252b32",
      "line-2": "#333b44",
      "accent": "#8aa2ff",
      "accent-solid": "#4a67e8",
      "on-accent": "#ffffff",
      "accent-ink": "#b9c6ff",
      "accent-soft": "#1c2434",
      "ok": "#63d3a3",
      "ok-soft": "#12241d",
      "warn": "#e0b25c",
      "bad": "#ff8f86",
      "mark-bg": "rgba(255,201,80,.18)",
      "mark-fg": "#ffd98a",
      "ico-folder": "#d9a94a"
    }
  },
  "font": {
    "family-ui": "Inter, 'Segoe UI', 'Noto Sans SC', 'Source Han Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "family-gtk": "system-ui, sans-serif",
    "size": {
      "micro": "11px",
      "meta": "11.5px",
      "label": "12.5px",
      "body": "13px",
      "title": "14px",
      "h": "15px",
      "field": "15.5px"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "line-height": { "tight": 1.3, "normal": 1.45, "loose": 1.7 }
  },
  "space": {
    "1": "2px", "2": "4px", "3": "6px", "4": "8px", "5": "10px",
    "6": "12px", "7": "14px", "8": "16px", "10": "24px", "14": "56px"
  },
  "radius": { "xs": "4px", "sm": "6px", "": "8px", "md": "10px", "lg": "12px", "full": "999px" },
  "shadow": {
    "1": "0 1px 2px rgba(17,24,39,.06)",
    "2": "0 12px 32px rgba(17,24,39,.14), 0 2px 8px rgba(17,24,39,.06)",
    "2-dark": "0 16px 40px rgba(0,0,0,.6), 0 2px 8px rgba(0,0,0,.4)"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.7,.3,1)",
    "fast": "100ms",
    "normal": "140ms",
    "slow": "180ms",
    "reduced": "1ms"
  },
  "size": {
    "appbar-h": "30px",
    "field-h": "44px",
    "chip-h": "28px",
    "status-h": "28px",
    "row-h": "48px",
    "preview-w": "340px",
    "gutter": "14px",
    "icon-in-row": "20px",
    "icon-in-preview": "46px",
    "hit-target-min": "32px"
  },
  "breakpoint": {
    "hide-preview": 1080,
    "chips-scroll": 860,
    "compact-meta": 720,
    "minimal-appbar": 560,
    "gtk-hide-preview": 960
  }
}
